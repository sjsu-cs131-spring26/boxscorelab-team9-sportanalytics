   "source": [
    "# PA5 – PySpark Collaborative Data Prep\n",
    "**Engineer:** Manuel Rafanan  \n",
    "**Sprint:** 5  \n",
    "**Dataset:** `TeamStatistics.csv`\n",
    "\n",
    "---\n",
    "### Tasks\n",
    "| # | Category | Task Name | Description |\n",
    "|---|----------|-----------|-------------|\n",
    "| 1 | Setup | Sprint 5 – Setup | Create Spark env, print version/config |\n",
    "| 2 | Data Prep | TeamStatistics Ingestion | Load CSV with explicit types, select key columns |\n",
    "| 3 | Transforms | Feature Engineering | year_month, three_pt_pct, efficiency |\n",
    "| 4 | Outputs | Table 1 | 3PT efficiency category table |\n",
    "| 5 | Outputs | Monthly Trends | avg_teamScore by year_month |\n",
    "| 6 | Engineering | Save Outputs | Consistent filenames and folders |"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Task 1 — Sprint 5 Setup\n",
    "> **Goal:** Install PySpark (Colab), create a SparkSession, and print the version + key config values so the setup is reproducible."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Install PySpark (only needed in Google Colab) ──────────────────────────\n",
    "# If you are running locally and already have PySpark installed, skip this cell.\n",
    "import subprocess, sys\n",
    "subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"pyspark\", \"--quiet\"])\n",
    "print(\"PySpark installed.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pyspark.sql import SparkSession\n",
    "\n",
    "# ── Create SparkSession ────────────────────────────────────────────────────\n",
    "spark = (\n",
    "    SparkSession.builder\n",
    "    .appName(\"PA5_TeamStatistics\")\n",
    "    .config(\"spark.executor.memory\", \"2g\")\n",
    "    .config(\"spark.sql.shuffle.partitions\", \"8\")   # small dataset → keep partitions low\n",
    "    .getOrCreate()\n",
    ")\n",
    "\n",
    "# ── Print version + configuration ─────────────────────────────────────────\n",
    "print(f\"PySpark version         : {spark.version}\")\n",
    "print(f\"executor.memory         : {spark.conf.get('spark.executor.memory')}\")\n",
    "print(f\"sql.shuffle.partitions  : {spark.conf.get('spark.sql.shuffle.partitions')}\")\n",
    "print(f\"App name                : {spark.sparkContext.appName}\")\n",
    "print(f\"Master                  : {spark.sparkContext.master}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Task 2 — Data Prep: TeamStatistics Ingestion\n",
    "> **Goal:** Load `TeamStatistics.csv` into a Spark DataFrame with an **explicit schema** (no infer-schema guessing). Keep only the columns required by the assignment."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pyspark.sql.types import (\n",
    "    StructType, StructField,\n",
    "    StringType, IntegerType, DoubleType, TimestampType\n",
    ")\n",
    "\n",
    "# ── Explicit schema for the columns we care about ─────────────────────────\n",
    "# Using a broad schema that covers the full CSV so Spark doesn't reject rows;\n",
    "# we select only the required columns immediately after loading.\n",
    "schema = StructType([\n",
    "    StructField(\"gameId\",                  StringType(),    True),\n",
    "    StructField(\"gameDateTimeEst\",          StringType(),    True),  # parsed later\n",
    "    StructField(\"teamCity\",                 StringType(),    True),\n",
    "    StructField(\"teamName\",                 StringType(),    True),\n",
    "    StructField(\"teamId\",                   StringType(),    True),\n",
    "    StructField(\"opponentTeamCity\",         StringType(),    True),\n",
    "    StructField(\"opponentTeamName\",         StringType(),    True),\n",
    "    StructField(\"opponentTeamId\",           StringType(),    True),\n",
    "    StructField(\"home\",                     IntegerType(),   True),\n",
    "    StructField(\"win\",                      IntegerType(),   True),\n",
    "    StructField(\"teamScore\",                IntegerType(),   True),\n",
    "    StructField(\"opponentScore\",            IntegerType(),   True),\n",
    "    StructField(\"assists\",                  IntegerType(),   True),\n",
    "    StructField(\"blocks\",                   IntegerType(),   True),\n",
    "    StructField(\"steals\",                   IntegerType(),   True),\n",
    "    StructField(\"fieldGoalsAttempted\",      IntegerType(),   True),\n",
    "    StructField(\"fieldGoalsMade\",           IntegerType(),   True),\n",
    "    StructField(\"fieldGoalsPercentage\",     DoubleType(),    True),\n",
    "    StructField(\"threePointersAttempted\",   IntegerType(),   True),\n",
    "    StructField(\"threePointersMade\",        IntegerType(),   True),\n",
    "    StructField(\"threePointersPercentage\",  DoubleType(),    True),\n",
    "    StructField(\"freeThrowsAttempted\",      IntegerType(),   True),\n",
    "    StructField(\"freeThrowsMade\",           IntegerType(),   True),\n",
    "    StructField(\"freeThrowsPercentage\",     DoubleType(),    True),\n",
    "    StructField(\"reboundsDefensive\",        IntegerType(),   True),\n",
    "    StructField(\"reboundsOffensive\",        IntegerType(),   True),\n",
    "    StructField(\"reboundsTotal\",            IntegerType(),   True),\n",
    "    StructField(\"foulsPersonal\",            IntegerType(),   True),\n",
    "    StructField(\"turnovers\",                IntegerType(),   True),\n",
    "    StructField(\"plusMinusPoints\",          IntegerType(),   True),\n",
    "    StructField(\"numMinutes\",               IntegerType(),   True),\n",
    "    StructField(\"q1Points\",                 IntegerType(),   True),\n",
    "    StructField(\"q2Points\",                 IntegerType(),   True),\n",
    "    StructField(\"q3Points\",                 IntegerType(),   True),\n",
    "    StructField(\"q4Points\",                 IntegerType(),   True),\n",
    "    StructField(\"benchPoints\",              IntegerType(),   True),\n",
    "    StructField(\"biggestLead\",              IntegerType(),   True),\n",
    "    StructField(\"biggestScoringRun\",        IntegerType(),   True),\n",
    "    StructField(\"leadChanges\",              IntegerType(),   True),\n",
    "    StructField(\"pointsFastBreak\",          IntegerType(),   True),\n",
    "    StructField(\"pointsFromTurnovers\",      IntegerType(),   True),\n",
    "    StructField(\"pointsInThePaint\",         IntegerType(),   True),\n",
    "    StructField(\"pointsSecondChance\",       IntegerType(),   True),\n",
    "    StructField(\"timesTied\",                IntegerType(),   True),\n",
    "    StructField(\"timeoutsRemaining\",        IntegerType(),   True),\n",
    "    StructField(\"seasonWins\",               IntegerType(),   True),\n",
    "    StructField(\"seasonLosses\",             IntegerType(),   True),\n",
    "    StructField(\"coachId\",                  StringType(),    True),\n",
    "])\n",
    "\n",
    "# ── Load CSV ───────────────────────────────────────────────────────────────\n",
    "# TODO: update this path if your CSV is in Google Drive or a different folder\n",
    "CSV_PATH = \"TeamStatistics.csv\"\n",
    "\n",
    "raw_df = (\n",
    "    spark.read\n",
    "    .option(\"header\", \"true\")\n",
    "    .option(\"mode\", \"PERMISSIVE\")   # keep malformed rows rather than crash\n",
    "    .schema(schema)\n",
    "    .csv(CSV_PATH)\n",
    ")\n",
    "\n",
    "print(f\"Total rows loaded: {raw_df.count():,}\")\n",
    "raw_df.printSchema()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Select only the required columns ──────────────────────────────────────\n",
    "REQUIRED_COLS = [\n",
    "    \"gameId\",\n",
    "    \"gameDateTimeEst\",\n",
    "    \"teamName\",\n",
    "    \"teamScore\",\n",
    "    \"assists\",\n",
    "    \"turnovers\",\n",
    "    \"threePointersMade\",\n",
    "    \"threePointersAttempted\",\n",
    "    \"win\",\n",
    "]\n",
    "\n",
    "team_df = raw_df.select(REQUIRED_COLS)\n",
    "\n",
    "print(f\"Rows after column selection: {team_df.count():,}\")\n",
    "team_df.show(5, truncate=False)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Task 3 — Transforms: Feature Engineering\n",
    "> **Goal:** Add three derived columns:\n",
    "> - `year_month` — `YYYY-MM` string extracted from `gameDateTimeEst`\n",
    "> - `three_pt_pct` — safe 3PT% (returns `null` when attempts = 0 to avoid divide-by-zero)\n",
    "> - `efficiency` — `(teamScore + assists) / turnovers`, protected against divide-by-zero\n",
    "> - `season_year` — 4-digit year (optional, useful for season-level grouping)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pyspark.sql import functions as F\n",
    "\n",
    "# ── Parse date string → proper timestamp ──────────────────────────────────\n",
    "# gameDateTimeEst format in CSV: \"2026-02-19 22:30:00\"\n",
    "team_df = team_df.withColumn(\n",
    "    \"game_ts\",\n",
    "    F.to_timestamp(F.col(\"gameDateTimeEst\"), \"yyyy-MM-dd HH:mm:ss\")\n",
    ")\n",
    "\n",
    "# ── year_month  (YYYY-MM) ─────────────────────────────────────────────────\n",
    "team_df = team_df.withColumn(\n",
    "    \"year_month\",\n",
    "    F.date_format(F.col(\"game_ts\"), \"yyyy-MM\")\n",
    ")\n",
    "\n",
    "# ── season_year  (YYYY) ───────────────────────────────────────────────────\n",
    "team_df = team_df.withColumn(\n",
    "    \"season_year\",\n",
    "    F.year(F.col(\"game_ts\"))\n",
    ")\n",
    "\n",
    "# ── three_pt_pct  (null-safe: return null when attempts = 0) ──────────────\n",
    "team_df = team_df.withColumn(\n",
    "    \"three_pt_pct\",\n",
    "    F.when(\n",
    "        F.col(\"threePointersAttempted\") == 0, None\n",
    "    ).otherwise(\n",
    "        F.round(\n",
    "            F.col(\"threePointersMade\") / F.col(\"threePointersAttempted\"),\n",
    "            4\n",
    "        )\n",
    "    )\n",
    ")\n",
    "\n",
    "# ── efficiency  = (teamScore + assists) / turnovers ───────────────────────\n",
    "# Protect against divide-by-zero: return null when turnovers = 0\n",
    "team_df = team_df.withColumn(\n",
    "    \"efficiency\",\n",
    "    F.when(\n",
    "        F.col(\"turnovers\") == 0, None\n",
    "    ).otherwise(\n",
    "        F.round(\n",
    "            (F.col(\"teamScore\") + F.col(\"assists\")) / F.col(\"turnovers\"),\n",
    "            4\n",
    "        )\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"Feature engineering complete. Sample rows:\")\n",
    "team_df.select(\n",
    "    \"gameId\", \"teamName\", \"year_month\", \"season_year\",\n",
    "    \"three_pt_pct\", \"efficiency\"\n",
    ").show(10, truncate=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Sanity check: make sure no divide-by-zero rows survived ───────────────\n",
    "zero_to_rows = team_df.filter(\n",
    "    (F.col(\"threePointersAttempted\") == 0) & F.col(\"three_pt_pct\").isNotNull()\n",
    ").count()\n",
    "\n",
    "zero_turnover_rows = team_df.filter(\n",
    "    (F.col(\"turnovers\") == 0) & F.col(\"efficiency\").isNotNull()\n",
    ").count()\n",
    "\n",
    "print(f\"Rows where 3PA=0 but three_pt_pct is NOT null (should be 0): {zero_to_rows}\")\n",
    "print(f\"Rows where turnovers=0 but efficiency is NOT null (should be 0): {zero_turnover_rows}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Task 4 — Output: Table 1 — 3PT Efficiency Categories\n",
    "> **Goal:** Group games into 3PT efficiency tiers and count how many game-team rows fall into each bucket. Shows PySpark `when/otherwise` bucketing + `groupBy/agg`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Assign 3PT efficiency category ────────────────────────────────────────\n",
    "# Thresholds based on NBA league averages (~35% is average, >40% is elite)\n",
    "team_with_cat = team_df.withColumn(\n",
    "    \"three_pt_category\",\n",
    "    F.when(F.col(\"three_pt_pct\").isNull(),        \"No Attempts\")\n",
    "     .when(F.col(\"three_pt_pct\") >= 0.40,         \"Elite (≥40%)\")\n",
    "     .when(F.col(\"three_pt_pct\") >= 0.35,         \"Above Average (35–39%)\")\n",
    "     .when(F.col(\"three_pt_pct\") >= 0.30,         \"Average (30–34%)\")\n",
    "     .otherwise(                                   \"Below Average (<30%)\")\n",
    ")\n",
    "\n",
    "# ── Aggregate: count games + avg teamScore per category ───────────────────\n",
    "table1 = (\n",
    "    team_with_cat\n",
    "    .groupBy(\"three_pt_category\")\n",
    "    .agg(\n",
    "        F.count(\"*\").alias(\"game_count\"),\n",
    "        F.round(F.avg(\"three_pt_pct\"), 4).alias(\"avg_three_pt_pct\"),\n",
    "        F.round(F.avg(\"teamScore\"), 2).alias(\"avg_teamScore\"),\n",
    "        F.round(F.avg(\"efficiency\"), 4).alias(\"avg_efficiency\"),\n",
    "        F.round(F.avg(\"win\"), 4).alias(\"win_rate\"),\n",
    "    )\n",
    "    .orderBy(F.desc(\"avg_three_pt_pct\"))\n",
    ")\n",
    "\n",
    "print(\"=== Table 1: 3PT Efficiency Categories ===\")\n",
    "table1.show(truncate=False)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Task 5 — Output: Monthly Trends\n",
    "> **Goal:** Group by `year_month` and compute `avg_teamScore` (and optionally `games_in_month`). Demonstrates a time-series aggregation using PySpark `groupBy/agg`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Monthly trend aggregation ──────────────────────────────────────────────\n",
    "monthly_trends = (\n",
    "    team_df\n",
    "    .filter(F.col(\"year_month\").isNotNull())        # drop rows with no date\n",
    "    .groupBy(\"year_month\")\n",
    "    .agg(\n",
    "        F.count(\"*\").alias(\"games_in_month\"),\n",
    "        F.round(F.avg(\"teamScore\"), 2).alias(\"avg_teamScore\"),\n",
    "        F.round(F.avg(\"assists\"), 2).alias(\"avg_assists\"),\n",
    "        F.round(F.avg(\"efficiency\"), 4).alias(\"avg_efficiency\"),\n",
    "    )\n",
    "    .orderBy(\"year_month\")\n",
    ")\n",
    "\n",
    "print(\"=== Monthly Trends ===\")\n",
    "monthly_trends.show(50, truncate=False)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Task 6 — Engineering: Save Outputs\n",
    "> **Goal:** Persist every final output to consistent folder names so teammates can locate files easily. Files are written as CSV (single partition for readability)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "\n",
    "# ── Output directory structure ─────────────────────────────────────────────\n",
    "# Change BASE_OUTPUT_DIR to your Google Drive mount path if using Colab:\n",
    "#   e.g. \"/content/drive/MyDrive/PA5/outputs\"\n",
    "BASE_OUTPUT_DIR = \"outputs/pa5\"\n",
    "\n",
    "PATHS = {\n",
    "    \"engineered\" : f\"{BASE_OUTPUT_DIR}/team_engineered\",\n",
    "    \"table1\"     : f\"{BASE_OUTPUT_DIR}/table1_3pt_categories\",\n",
    "    \"monthly\"    : f\"{BASE_OUTPUT_DIR}/monthly_trends\",\n",
    "}\n",
    "\n",
    "# ── Helper: write a DataFrame as a single CSV file ─────────────────────────\n",
    "def save_csv(df, path, label):\n",
    "    \"\"\"\n",
    "    Coalesces to 1 partition so the output is one clean CSV file.\n",
    "    Spark still writes it inside a folder (part-00000-…csv); that's normal.\n",
    "    \"\"\"\n",
    "    (\n",
    "        df.coalesce(1)\n",
    "        .write\n",
    "        .mode(\"overwrite\")\n",
    "        .option(\"header\", \"true\")\n",
    "        .csv(path)\n",
    "    )\n",
    "    print(f\"✓ Saved {label} → {path}\")\n",
    "\n",
    "\n",
    "# ── Save engineered DataFrame (full feature set) ───────────────────────────\n",
    "save_csv(team_df,       PATHS[\"engineered\"], \"Engineered team data\")\n",
    "\n",
    "# ── Save Table 1 ───────────────────────────────────────────────────────────\n",
    "save_csv(table1,        PATHS[\"table1\"],     \"Table 1 – 3PT categories\")\n",
    "\n",
    "# ── Save Monthly Trends ────────────────────────────────────────────────────\n",
    "save_csv(monthly_trends, PATHS[\"monthly\"],   \"Monthly trends\")\n",
    "\n",
    "print(\"\\nAll outputs saved successfully.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Verify files exist ─────────────────────────────────────────────────────\n",
    "for label, path in PATHS.items():\n",
    "    files = [f for f in os.listdir(path) if f.endswith(\".csv\")] if os.path.exists(path) else []\n",
    "    status = f\"{len(files)} CSV file(s)\" if files else \"NOT FOUND\"\n",
    "    print(f\"{label:12s} → {path}  [{status}]\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
